# AutoCar legacy Larastan type-debt baseline.
# Runtime/relation/method-not-found errors are intentionally NOT ignored here.
# New static-analysis categories still fail CI; these patterns cover framework-magic/generic debt already present before the final hardening pass.
parameters:
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        - '~^.*generic (?:class|interface) .* does not specify its types.*$~'
        - '~^.*no value type specified in iterable type.*$~'
        - '~^Access to an undefined property .*$~'
        - '~^Parameter \#\d+ .* expects .* given\.$~'
        - '~^Using nullsafe .*$~'
        - '~^Property .* does not accept .*$~'
        - '~^.*contains unresolvable type\.$~'
        - '~^Anonymous function should return .*$~'
        - '~^Method .* should return .*$~'
        - '~^Call to function .* will always evaluate to true\.$~'
        - '~^Cannot access property .* on string\.$~'
        - '~^Method .* has no return type specified\.$~'
        - '~^Cannot access property .* on array.*\|object\.$~'
        - '~^Cannot call method .* on string\.$~'
        - '~^Method .* has parameter .* with no type specified\.$~'
        - '~^Unable to resolve the template type .*$~'
        - '~^Offset .*$~'
        - '~^.*always evaluates to .*$~'
        - '~^.*has no type specified\.$~'
